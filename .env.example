APP_ENV=local
AI_MODE=demo
# catalog = legacy fixture planner. rag = local retrieval (needs a snapshot).
# Code defaults to catalog when this variable is absent, so older installs keep working.
KNOWLEDGE_MODE=rag
KNOWLEDGE_SNAPSHOT=india-v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_MODEL_REVISION=
RETRIEVAL_STRATEGY=hybrid_rerank
RETRIEVAL_TOP_K=30
RERANK_TOP_K=8
GRAPH_MAX_HOPS=2
ALLOW_NETWORK_TOOLS=false
ALLOW_MODEL_DOWNLOAD=false
MAP_MODE=offline
HTTP_USER_AGENT=TerraTravelGraph/1.0 (https://github.com/jishnusinha/Travel-Graph-AI; local ingest)
OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_URL=sqlite+aiosqlite:///./data/travelgraph.sqlite
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-in-local-env-with-a-random-long-value
SEED_DEMO_DATA=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
